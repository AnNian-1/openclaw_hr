#!/usr/bin/env bash
# Copy to env.sh and fill in your own keys. Never commit env.sh.
# Point STATE_DIR at this profile directory (repo/.openclaw-hr), not ~/.openclaw-hr.
export OPENCLAW_STATE_DIR="${OPENCLAW_STATE_DIR:-$HOME/openclaw-hr/.openclaw-hr}"
export OPENCLAW_GATEWAY_TOKEN="replace-with-random-token"
# Gateway 主模型
export XIAOMI_API_KEY="tp-..."
# 部分招聘脚本仍用
export DEEPSEEK_API_KEY="sk-..."
export DASHSCOPE_API_KEY="sk-..."
# Vector / embedding (talent-pool ingest + OpenClaw memorySearch)
export SILICONFLOW_API_KEY="sk-..."
export EMBEDDING_MODEL="Qwen/Qwen3-Embedding-0.6B"
export EMBEDDING_DIM="1024"
export EMBEDDING_BASE_URL="https://api.siliconflow.cn/v1"
# 飞书（appId 在 openclaw.yaml）
export FEISHU_APP_SECRET="..."
# 腾讯 IMA 政策库
export IMA_OPENAPI_CLIENTID="..."
export IMA_OPENAPI_APIKEY="..."
export IMA_HR_KNOWLEDGE_BASE_ID="..."
# 可选：招聘收信（默认 mock，不上真实邮箱）
# export IMAP_USER="..."
# export IMAP_PASS="..."
# export IMAP_HOST="imap.qq.com"
# export IMAP_PORT="993"
# export MAIL_FOLDER="INBOX"
# export MAIL_BACKEND="live"
# 可选：入职 HCM（默认 http://127.0.0.1:8000）
# export HCM_API_URL="http://127.0.0.1:8000"
# FunASR 环境路径（转写；不要把 funasr 装进 openclaw-hr）
# export FUNASR_VENV="$HOME/miniconda3/envs/funasr_me"
# 乐奇眼镜 App 上传服务 :18791（眼镜 Bearer；不要写成 Gateway token）
export ROKID_APP_INGEST_SECRET="replace-with-random-token"
# 入职 7/30/60/90 催办投递到 HR 飞书（open_id，形如 ou_xxx 或 user:ou_xxx）
# 未设置时，schedule 脚本会回退到 credentials/feishu-default-allowFrom.json 的第一项
# export ONBOARDING_REVIEW_FEISHU_TO="ou_xxxxxxxx"



