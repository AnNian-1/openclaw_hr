  "messages": {
    "tts": {
      "providers": {
        "tts-local-cli": {
          "command": "/opt/openclaw-hr/.openclaw-hr/workspace-recruitment/interview/scripts/tts-say.sh",
          "args": [
            "{{Text}}",
            "{{OutputPath}}"
          ],
          "outputFormat": "wav",
          "timeoutMs": 120000
        }
      },
      "provider": "tts-local-cli"
    },
    "groupChat": {
      "visibleReplies": "message_tool"
    }
