    "defaults": {
      "timeoutSeconds": 1800,
      "memorySearch": {
        "enabled": true,
        "provider": "openai",
        "model": "Qwen/Qwen3-Embedding-0.6B",
        "remote": {
          "baseUrl": "https://api.siliconflow.cn/v1",
          "apiKey": {
            "source": "env",
            "provider": "default",
            "id": "SILICONFLOW_API_KEY"
          }
        }
      },
      "model": {
        "primary": "xiaomi/mimo-v2.5-pro",
        "fallbacks": []
      },
      "subagents": {
        "allowAgents": [],
        "requireAgentId": true,
        "maxChildrenPerAgent": 8,
        "maxConcurrent": 8,
        "runTimeoutSeconds": 1800
      }
    }
