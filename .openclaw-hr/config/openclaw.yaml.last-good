  "channels": {
    "feishu": {
      "enabled": true,
      "appId": "cli_aadf585d2ffc9cc4",
      "appSecret": {
        "source": "env",
        "provider": "default",
        "id": "FEISHU_APP_SECRET"
      },
      "connectionMode": "websocket",
      "domain": "feishu",
      "dmPolicy": "pairing",
      "groupPolicy": "allowlist",
      "requireMention": true,
      "groupAllowFrom": [
        "oc_65551edeef1db539a87122dd4833663d"
      ],
      "groups": {
        "*": {
          "tools": {
            "allow": [
              "exec",
              "read",
              "write",
              "edit",
              "apply_patch"
            ],
            "deny": [
              "browser",
              "cron",
              "sessions_spawn",
              "sessions_yield"
            ]
          }
        },
        "oc_65551edeef1db539a87122dd4833663d": {
          "enabled": true,
          "requireMention": true,
          "tools": {
            "allow": [
              "exec",
              "read",
              "write",
              "edit",
              "apply_patch"
            ],
            "deny": [
              "browser",
              "cron",
              "sessions_spawn",
              "sessions_yield"
            ]
          }
        }
      }
    }
  },
  "commands": {
    "ownerAllowFrom": [
      "feishu:ou_a8cf75f38e774b2c1a5c79117004d965"
    ]
  },
  "diagnostics": {
    "enabled": true,
    "otel": {
      "enabled": true,
      "endpoint": "http://127.0.0.1:4318",
      "protocol": "http/protobuf",
      "serviceName": "openclaw-hr",
      "sampleRate": 1,
      "flushIntervalMs": 10000
    }
  },
  "tools": {
    "fs": {
      "workspaceOnly": true
    },
    "exec": {
      "applyPatch": {
        "workspaceOnly": true
      }
    },
    "alsoAllow": [
      "lobster",
      "llm-task"
    ],
    "agentToAgent": {
      "enabled": true,
      "allow": [
        "recruitment",
        "onboarding",
        "training",
        "performance",
        "er-admin",
        "router"
      ]
    },
    "toolsBySender": {
      "*": {
        "allow": [
          "*"
        ]
      }
    }
  },
  "bindings": [
    {
      "agentId": "er-admin",
      "match": {
        "channel": "feishu",
        "accountId": "*"
      }
    },
    {
      "agentId": "router",
      "match": {
        "channel": "webchat",
        "accountId": "*"
      }
    }
  ],
  "agents": {
    "list": [
      {
        "id": "main",
        "subagents": {
          "allowAgents": []
        }
      },
      {
        "id": "recruitment",
        "name": "recruitment",
        "workspace": "/opt/openclaw-hr/.openclaw-hr/workspace-recruitment",
        "agentDir": "/opt/openclaw-hr/.openclaw-hr/agent-dirs/recruitment",
        "tools": {
          "allow": [
            "group:memory",
            "group:web",
            "group:fs",
            "group:sessions",
            "group:media",
            "group:runtime"
          ],
          "fs": {
            "workspaceOnly": true
          },
          "exec": {
            "security": "allowlist",
            "ask": "off",
            "safeBins": [
              "python3",
              "node",
              "bash",
              "pip",
              "pip3",
              "source",
              "cat",
              "ls",
              "head",
              "tail",
